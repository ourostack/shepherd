// The agent-facing doors of shepherd, declared once: the sessions of the GitHub Copilot app, read and acted on. Generate the
// projections with
//   node tools/ouro-actions/ouro-actions.mts generate actions/shepherd.actions.mts actions/generated
// and never edit actions/generated by hand.
import { defineAction, defineActions, field } from "../tools/ouro-actions/ouro-actions.mts";

const session = field.string({ label: "Session", description: "The session: its whole id, or the first 8 or more characters of it.", arg: true });
const ok = field.boolean({ label: "Done", description: "True when the app did it; false when it was refused, with the reason in the result." });

export const sessionsRead = defineAction({
  id: "sessions",
  consent: "read",
  label: "List the sessions",
  description: "Every session in the sidebar: a summary and each session's activity.",
  agent: "List the app's sessions and what each is doing. Read-only.",
  input: {
    state: field.enum({ label: "State", description: "Keep only the sessions in this state.", values: ["busy", "idle", "waiting", "stuck"], optional: true }),
  },
  output: { ok },
  cli: "sessions",
});

export const sessionRead = defineAction({
  id: "session",
  consent: "read",
  label: "Read one session",
  description: "One session, with what it waits on.",
  agent: "Read one session and the question or plan it waits on, if any. Read-only.",
  input: { id: session },
  output: { ok },
  cli: "session",
});

export const messagesRead = defineAction({
  id: "messages",
  consent: "read",
  label: "Read a session's messages",
  description: "A session's last messages, oldest first.",
  agent: "Read the last messages of a session. Read-only.",
  input: {
    id: session,
    count: field.integer({ label: "Count", description: "How many messages. Defaults to 6.", optional: true, min: 1 }),
  },
  output: { ok },
  cli: "messages",
});

export const workflowsRead = defineAction({
  id: "workflows",
  consent: "read",
  label: "List the workflows",
  description: "The app's workflows.",
  agent: "List the app's workflows. Read-only.",
  input: {},
  output: { ok },
  cli: "workflows",
});

export const openSession = defineAction({
  id: "open",
  consent: "read",
  label: "Show a session",
  description: "Show a session in the app's window.",
  agent: "Bring a session to the front of the app's window. Read-only.",
  input: { id: session },
  output: { ok },
  cli: "open",
});

export const sendMessage = defineAction({
  id: "send",
  consent: "consequential",
  label: "Message a session",
  description: "Send a message to a session, as a peer message.",
  agent: "Send a message to a session, which its owner may read. A person says yes first.",
  input: {
    id: session,
    message: field.string({ label: "Message", description: "The text to send." }),
    delivery: field.enum({ label: "Delivery", description: "Now, or behind what the session is doing.", values: ["immediate", "enqueue"], optional: true }),
  },
  output: { ok },
  cli: "send",
});

export const createSession = defineAction({
  id: "create",
  consent: "consequential",
  label: "Create a session",
  description: "Make a session on a project (or a chat), optionally with a first prompt.",
  agent: "Create a session in the app, which its owner will see. A person says yes first.",
  input: {
    project: field.string({ label: "Project", description: "The project, by id or name.", optional: true }),
    name: field.string({ label: "Name", description: "The title.", optional: true }),
    prompt: field.string({ label: "Prompt", description: "The first prompt.", optional: true }),
  },
  output: { ok },
  cli: "create",
});

export const answerQuestion = defineAction({
  id: "answer_question",
  consent: "consequential",
  label: "Answer a session's question",
  description: "Answer a question the watch heard the session ask.",
  agent: "Answer a question a session asked, as the session's owner would. A person says yes first.",
  input: {
    id: session,
    answer: field.string({ label: "Answer", description: "The answer." }),
  },
  output: { ok },
  cli: "answer",
});

export const decidePlan = defineAction({
  id: "plan",
  consent: "consequential",
  label: "Approve or reject a plan",
  description: "Approve or reject a plan the watch heard a session offer.",
  agent: "Approve or reject a plan a session offered. A person says yes first.",
  input: {
    id: session,
    approved: field.boolean({ label: "Approved", description: "True to approve, false to reject." }),
    feedback: field.string({ label: "Feedback", description: "What to tell the session.", optional: true }),
  },
  output: { ok },
  cli: "plan",
});

export const archiveSession = defineAction({
  id: "archive",
  consent: "consequential",
  label: "Archive a session",
  description: "Archive a session this agent created, or one the owner asked to archive.",
  agent: "Archive a session. A person says yes first.",
  input: {
    id: session,
    ownerAsked: field.boolean({ label: "Owner asked", description: "The owner asked for this archive, so a session this agent did not create may go.", optional: true }),
  },
  output: { ok },
  cli: "archive",
});

export const automationAction = defineAction({
  id: "automation",
  consent: "consequential",
  label: "Read or change a session's automation",
  description: "A session's automations (with no fields), replace one, or clear it.",
  agent: "Read, replace or clear a session's automation, which sends messages on a schedule. A person says yes first.",
  input: {
    id: session,
    clear: field.boolean({ label: "Clear", description: "Remove the session's automation.", optional: true }),
    prompt: field.string({ label: "Prompt", description: "What the automation sends.", optional: true }),
  },
  output: { ok },
  cli: "automation",
});

export const runWorkflow = defineAction({
  id: "run_workflow",
  consent: "consequential",
  label: "Run a workflow",
  description: "Run one workflow now.",
  agent: "Run one of the app's workflows now. A person says yes first.",
  input: { id: field.string({ label: "Workflow", description: "The workflow's id, from workflows.", arg: true }) },
  output: { ok },
  cli: "run-workflow",
});

export default defineActions("shepherd", [sessionsRead, sessionRead, messagesRead, workflowsRead, openSession, sendMessage, createSession, answerQuestion, decidePlan, archiveSession, automationAction, runWorkflow], { tool: "shepherd" });
